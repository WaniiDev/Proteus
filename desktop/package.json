{
  "name": "proteus-desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Proteus personal AI companion desktop application",
  "scripts": {
    "dev": "NODE_USE_SYSTEM_CA=1 electrobun prepare && vite build && NODE_USE_SYSTEM_CA=1 electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "NODE_USE_SYSTEM_CA=1 electrobun prepare && vite --port 5173",
    "start": "NODE_USE_SYSTEM_CA=1 electrobun prepare && vite build && NODE_USE_SYSTEM_CA=1 electrobun dev",
    "build": "NODE_USE_SYSTEM_CA=1 electrobun prepare --env=stable && vite build && NODE_USE_SYSTEM_CA=1 electrobun build --env=stable",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test",
    "preview:ui": "vite --config vite.preview.config.ts --port 5181"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.82",
    "@ai-sdk/openai": "4.0.96",
    "@anthropic-ai/sdk": "0.135.0",
    "@mastra/ai-sdk": "1.11.1",
    "@mastra/code-sdk": "1.14.0",
    "@mastra/core": "1.78.0",
    "@mastra/fastembed": "1.3.3",
    "@mastra/libsql": "1.26.2",
    "@mastra/memory": "1.38.0",
    "@napi-rs/keyring": "2.1.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "electrobun": "2.0.4",
    "lucide-react": "1.59.0",
    "mathjs": "15.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@happy-dom/global-registrator": "20.14.6",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
