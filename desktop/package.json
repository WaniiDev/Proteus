{
  "name": "proteus-desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "PROTEUS personal AI companion desktop application",
  "scripts": {
    "dev": "vite build && NODE_USE_SYSTEM_CA=1 electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "start": "vite build && NODE_USE_SYSTEM_CA=1 electrobun dev",
    "build": "vite build && NODE_USE_SYSTEM_CA=1 electrobun build --env=production",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@mastra/core": "1.55.0",
    "@mastra/libsql": "1.18.0",
    "@mastra/memory": "1.24.0",
    "drizzle-orm": "0.45.2",
    "electrobun": "1.18.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "xstate": "5.32.5",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.3",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
